{
  "name": "landing-luxsur",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run server:dev\" \"vite\"",
    "server": "node server/index.js",
    "server:dev": "node --watch-path=server/index.js --watch-path=server/controllers --watch-path=server/routes --watch-path=server/middleware --watch-path=server/config server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.30.0",
